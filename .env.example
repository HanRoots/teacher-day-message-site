# 服务端
PORT=4173
ADMIN_PASSWORD=请替换为强密码
SESSION_SECRET=请替换为至少32位随机字符串
# GitHub Pages 正式地址；多个地址用英文逗号分隔
FRONTEND_ORIGIN=https://hanroots.github.io

# 阿里云 OSS（建议使用仅允许指定前缀写入的 RAM 子账号）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
# 可选：自定义 endpoint，例如 https://oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
# 私有 Bucket 请设为 true，后台会生成 10 分钟播放链接
OSS_PRIVATE=true
# 上传文件限制，默认 8MB
MAX_AUDIO_BYTES=8388608
